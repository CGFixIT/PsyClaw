# CyClaw Telemetry Kill Switch - RIP consoledonottrack.com ...
# Source this before running: source cyclaw_telemetry_kill.env
# out of respect, https://web.archive.org/web/20210706154145/https://consoledonottrack.com/
# some may look at that and say, wait... consoledonottrack.com is a ridiculous domain to use for a dog blog, so... yeah. anyways.
#
# Every var below EXCEPT HF_HUB_OFFLINE/TRANSFORMERS_OFFLINE is also set
# automatically at import time, unconditionally, by every CyClaw entry point
# (utils/telemetry_kill.py, applied by gate.py / mcp_hybrid_server.py /
# retrieval/vector_store.py). This file adds nothing for those beyond
# documenting them -- sourcing it by hand is redundant with running CyClaw at
# all, and harmless.
#
# HF_HUB_OFFLINE/TRANSFORMERS_OFFLINE are the one deliberate exception: forcing
# them on for every run would break the documented first-time model download
# in retrieval/embeddings.py on any machine that has never run CyClaw before
# (huggingface_hub latches HF_HUB_OFFLINE at its own import time -- there is no
# way to retry past that once set). CyClaw sets these two ITSELF, but only once
# it has confirmed the embedding model is already cached on disk (see
# retrieval/embeddings.py::_model_offline_eligible) -- not unconditionally at
# startup like the rest of this file. Source this file by hand only when you
# already know the model is cached and want the stronger, unconditional
# guarantee regardless of that check (e.g. a locked-down deployment where you
# have pre-seeded the cache yourself and want offline mode enforced even
# before CyClaw's own probe would kick in).


ANONYMIZED_TELEMETRY=False
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
ORT_TELEMETRY_OPT_OUT=1
LANGGRAPH_CLI_NO_ANALYTICS=1
CHROMA_OTEL_GRANULARITY=none
CHROMA_OTEL_COLLECTION_ENDPOINT=
CHROMA_OTEL_SERVICE_NAME=
OTEL_SDK_DISABLED=true
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
