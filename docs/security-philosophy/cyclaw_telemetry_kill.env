# CyClaw Telemetry Kill Switch - RIP consoledonottrack.com ...
# Source this before running: source cyclaw_telemetry_kill.env
# out of respect, https://web.archive.org/web/20210706154145/https://consoledonottrack.com/
# some may look at that and say, wait... consoledonottrack.com is a ridiculous domain to use for a dog blog, so... yeah. anyways.
#
# Every line uses `export KEY=value` so the values are INHERITED by child
# processes (brew, gh, python) -- a bare KEY=value would set shell-local
# variables that never reach a child. Format is contractual:
# tests/test_reference_env.py sources this file and asserts a child Python
# sees these exact values, and the otel-hardening checker rejects duplicate,
# malformed, or drifted lines.
#
# Section 1 is also set automatically, unconditionally, at import time by
# every CyClaw Python entry point (utils/telemetry_kill.py -- gate.py, the
# MCP server, the indexer, metrics, the harness server, and the
# sync/agentic/guardrails/telegram/opentweet packages), and delivered as
# literal environment by the Docker image, the shipped launchers, and every
# generated launchd plist / Windows task / cron line. Sourcing it by hand is
# therefore redundant with running CyClaw -- and harmless. Sections 2 and 3
# are the operator-choice parts; read their notes.
#
# Scope, stated precisely: these variables disable unsolicited vendor
# telemetry/analytics and ancillary version checks. They are NOT a network
# kill switch -- CyClaw's intentional, policy-gated egress (triple-gated
# cloud models, Telegram, OpenTweet, rclone/Dropbox, the one-time embedding
# bootstrap) is governed by its own gates, documented in SECURITY.md's
# egress classification, and unaffected by this file.

# --- 1. Unconditional telemetry kill -------------------------------------
# Exact mirror of utils/telemetry_kill.py TELEMETRY_KILL (checker-pinned).
# All four names below are one switch. langsmith resolves them in the order
# LANGSMITH_TRACING_V2 > LANGCHAIN_TRACING_V2 > LANGSMITH_TRACING >
# LANGCHAIN_TRACING and stops at the first non-empty one, so every name has to
# be pinned -- leaving one out lets an ambient value there win over the rest.
export LANGSMITH_TRACING_V2=false
export LANGCHAIN_TRACING_V2=false
export LANGSMITH_TRACING=false
export LANGCHAIN_TRACING=false
export LANGSMITH_OTEL_ENABLED=false
export LANGGRAPH_CLI_NO_ANALYTICS=1
export NEMO_GUARDRAILS_NO_USAGE_STATS=1
export ANONYMIZED_TELEMETRY=False
export HF_HUB_DISABLE_TELEMETRY=1
export DO_NOT_TRACK=1
# The REAL ONNX Runtime env control (Privacy.md; effective for the non-Windows
# 1DS telemetry path added in v1.29.0). Must exist before onnxruntime
# initializes; the runtime API disable_telemetry_events() is the post-import
# second layer (utils/onnx_telemetry.py). Windows ETW telemetry only leaves
# the box when an external trace session collects it; absolute suppression
# there needs a --no_telemetry private build.
export ORT_DISABLE_TELEMETRY=1
# INERT LEGACY MARKER -- read by nothing (verified against onnxruntime 1.28/
# 1.29; the documented name is ORT_DISABLE_TELEMETRY above). Kept only so
# this file and utils/telemetry_kill.py stay in lockstep; never count it as
# protection.
export ORT_TELEMETRY_OPT_OUT=1
# GitHub CLI usage telemetry (gh >= 2.83; accepts true/false/log). CyClaw
# also forces this onto every gh child it spawns (agentic/gh_client.py,
# agentic/writer.py), so an ambient "true"/"log" can never win there.
export GH_TELEMETRY=false
# pwsh reads this ONCE, at its own startup: it must be in the PARENT
# environment before PowerShell launches. Sourcing this file inside an
# already-running pwsh cannot un-send that host's startup telemetry -- it
# only covers pwsh processes started afterwards. CyClaw's installed cmd
# shim and generated task wrappers set it before their powershell line.
export POWERSHELL_TELEMETRY_OPTOUT=1
# ChromaDB 1.5.9 (pinned) legacy OTel surface: granularity "none" makes
# otel_init() return before building any exporter; the two blank names
# below only deny a destination. Current Chroma releases renamed this
# surface -- these names are recorded for the PINNED version.
export CHROMA_OTEL_GRANULARITY=none
export CHROMA_OTEL_COLLECTION_ENDPOINT=
export CHROMA_OTEL_SERVICE_NAME=
# Generic OTel SDK kill. NOTE: a declarative config file outranks these --
# which is why CyClaw REMOVES OTEL_CONFIG_FILE/OTEL_EXPERIMENTAL_CONFIG_FILE
# from its environment outright (utils/telemetry_kill.SCRUBBED_ENV_KEYS);
# there is no "safe value" to pin for a config-file pointer, so unset them
# in your shell too if present.
export OTEL_SDK_DISABLED=true
export OTEL_TRACES_EXPORTER=none
export OTEL_METRICS_EXPORTER=none
export OTEL_LOGS_EXPORTER=none

# --- 2. Ancillary update-check opt-outs (egress, NOT telemetry) ----------
# Version/update checks phone a release endpoint, not an analytics sink.
# Kept visibly separate so no report counts them as telemetry controls.
# The first four mirror utils/telemetry_kill.py UPDATE_CHECK_OPT_OUT and are
# applied by every CyClaw process/boundary above.
export GH_NO_UPDATE_NOTIFIER=1
export GH_NO_EXTENSION_UPDATE_NOTIFIER=1
export POWERSHELL_UPDATECHECK=Off
export PIP_DISABLE_PIP_VERSION_CHECK=1
# Shell-only from here down: these govern programs CyClaw never launches, so
# a key in the Python dict would sit unread, advertising a protection CyClaw
# does not provide (the ORT_TELEMETRY_OPT_OUT lesson). Exported here they DO
# work, because your shell launches those programs and they inherit it.
#
# hf CLI update check (the `hf`/huggingface-cli tool; the LIBRARY has no
# update check and CyClaw never spawns the CLI):
export HF_HUB_DISABLE_UPDATE_CHECK=1
# Homebrew reports its own install/usage counts, not anything about CyClaw or
# your queries -- operator machine hygiene. CyClaw spawns brew nowhere;
# macos/setup-from-clone.sh exports this itself before its own brew calls.
# The persistent alternative (writes a config file, survives every shell):
#   brew analytics off        Docs: https://docs.brew.sh/Analytics
export HOMEBREW_NO_ANALYTICS=1

# --- 3. Conditional strict-offline (read the warning) --------------------
# NOT set automatically. Forcing these on for every run would break the
# documented first-time model download in retrieval/embeddings.py on any
# machine that has never run CyClaw (huggingface_hub latches HF_HUB_OFFLINE
# at its own import time -- no retry past that once set). CyClaw sets both
# ITSELF, but only after confirming the embedding model is already cached
# (retrieval/embeddings.py::_model_offline_eligible). Source this section
# only when you know the model is cached and want the stronger unconditional
# guarantee (e.g. a locked-down deployment with a pre-seeded cache).
#
# Shipped COMMENTED OUT precisely because `source` cannot pick sections: an
# operator following the header's source command on a fresh install would
# otherwise export these to every child and break the one-time bootstrap
# download. Uncomment the two lines below only under the condition above.
# export HF_HUB_OFFLINE=1
# export TRANSFORMERS_OFFLINE=1
