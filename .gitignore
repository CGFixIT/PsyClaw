# ==============================================================================
# CyClaw .gitignore
# ==============================================================================

# Git metadata
.git/
.gitleaksignore

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# CyClaw runtime artifacts (never commit these)
index/
.emb_cache/
logs/
*.jsonl
data/personality/*.db
data/personality/*.db-shm
data/personality/*.db-wal
data/personality/soul.md.bak
data/memory/
data/memory/*.db
data/memory/*.db-shm
data/memory/*.db-wal
data/auth/*.db
data/auth/*.db-shm
data/auth/*.db-wal
# Telegram poller state (getUpdates offset) — never commit runtime offset
data/telegram/

# Corpus content (personal knowledge base — keep private)
# data/corpus/   <-- uncomment this line to gitignore your corpus

# Secrets
*.env
!cyclaw_telemetry_kill.env
!macos/ollama-mlx.env
.env.*
!.env.example

# Local pre-push PR body (hook reads the working tree; never re-commit)
PR_BODY.md

# OS
.DS_Store
Thumbs.db
*.lnk

# Windows shortcuts and junk
desktop.ini

# Zip archives
*.zip
*.tar.gz

# Codacy / CI artifacts
results.sarif
codacy-*.sarif

# rclone / Dropbox sync (never commit credentials or local sync state)
rclone.conf
**/rclone.conf
.rclone-state/

# Coverage artifacts
.coverage
coverage.xml
htmlcov/

# Memory orchestrator runtime state (regenerable; snapshots themselves stay committable)
docs/memories/.orchestrator-state.json
# Derived working-set + index are rewritten from scratch on every orchestrator
# pass (like the state file above), so they are regenerable artifacts rather than
# source. The dated snapshot files (docs/memories/<date_time>.md) remain tracked.
docs/memories/INDEX.md
docs/memories/CONSOLIDATED.md

# Selective torch wheel cache (CI artifact, never commit wheels)
.torch-wheels/

# Claude Code agent worktree isolation (runtime scaffolding, never repo content)
.claude/worktrees/
.venv-tg/

# Claude Code remote-session cruft: a CLAUDE_CONFIG_DIR env var carrying a
# Windows path (C:\Users\<user>\.claude\) into a Linux container resolves as a
# *relative* path and materializes a literal "C:\Users\..." directory at the
# repo root holding live session state (.claude.json, transcripts, task locks)
# that must never be committed. Guard the drive-letter pattern, not a username.
/C:*

# Claude Code personal per-machine overrides (local permission grants, operator
# preferences). settings.json is the shared project config; settings.local.json
# is operator-specific and must never be committed.
.claude/settings.local.json
